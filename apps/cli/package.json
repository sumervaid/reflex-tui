{
  "name": "reflex-skills",
  "version": "0.2.0",
  "type": "module",
  "description": "Turn repeated Claude Code and Codex workflows into reusable skills, locally.",
  "keywords": [
    "claude-code",
    "codex",
    "skills",
    "cli",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumervaid/reflex-tui.git",
    "directory": "apps/cli"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "reflex": "./dist/reflex.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "cp ../../README.md ./README.md && pnpm build"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@reflex/adapters": "workspace:*",
    "@reflex/analysis": "workspace:*",
    "@reflex/core": "workspace:*",
    "@reflex/embeddings": "workspace:*",
    "@reflex/safety": "workspace:*",
    "@reflex/skills": "workspace:*",
    "@reflex/storage": "workspace:*",
    "@reflex/test-fixtures": "workspace:*",
    "@reflex/tui": "workspace:*",
    "commander": "^14.0.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.0"
  }
}
